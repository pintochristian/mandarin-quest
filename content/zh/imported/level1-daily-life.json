          "title": "What Time Is It?",
          "situationTag": "daily-life",
          "estimatedMinutes": 18,
          "isPublished": true,
          "grammar": {
            "code": "time-telling",
            "title": "Telling Time (点)",
            "simpleExplanation": "点 (diǎn) is how you say 'o'clock' — just put a number before it. 三点 = 3 o'clock. For the half hour, add 半 (bàn, 'half') right after: 三点半 = 3:30. To ask what time it is, use 几点 (jǐ diǎn), literally 'how many o'clock' — 现在几点? = What time is it now?",
            "visualExamples": [
              {
                "script": "三点",
                "romanization": "sān diǎn",
                "english": "3 o'clock"
              },
              {
                "script": "三点半",
                "romanization": "sān diǎn bàn",
                "english": "3:30",
                "note": "半 after 点 means 'half past'"
              },
              {
                "script": "现在几点?",
                "romanization": "Xiànzài jǐ diǎn?",
                "english": "What time is it now?"
              }
            ],
            "difficulty": 2,
            "quiz": [
              {
                "prompt": "What does 点 mean in a time expression?",
                "options": ["o'clock", "minute", "half", "now"],
                "correctIndex": 0
              },
              {
                "prompt": "How do you say '7:30'?",
                "options": ["七点半", "半点七", "七半点", "点七半"],
                "correctIndex": 0
              }
            ]
          },
          "vocabulary": [
            { "script": "点", "romanization": "diǎn", "english": "o'clock (hour marker)" },
            { "script": "半", "romanization": "bàn", "english": "half" },
            { "script": "现在", "romanization": "xiànzài", "english": "now" },
            { "script": "几点", "romanization": "jǐ diǎn", "english": "what time?" },
