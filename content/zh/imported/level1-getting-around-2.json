            "title": "Hailing a Taxi",
            "situationTag": "taxi",
            "lines": [
              {
                "speaker": "Passenger",
                "script": "师傅,你好!我要到火车站。",
                "romanization": "Shīfu, nǐ hǎo! Wǒ yào dào huǒchēzhàn.",
                "english": "Hello, driver! I need to go to the train station."
              },
              {
                "speaker": "Driver",
                "script": "好的,火车站在附近。",
                "romanization": "Hǎo de, huǒchēzhàn zài fùjìn.",
                "english": "Okay, the train station is nearby."
              },
              {
                "speaker": "Passenger",
                "script": "很好,谢谢!我很忙,请快一点。",
                "romanization": "Hěn hǎo, xièxie! Wǒ hěn máng, qǐng kuài yìdiǎn.",
                "english": "Great, thanks! I'm in a hurry, please go a bit faster."
              },
              {
                "speaker": "Driver",
                "script": "好,我们走。",
                "romanization": "Hǎo, wǒmen zǒu.",
                "english": "Okay, let's go."
              },
              {
                "speaker": "Passenger",
                "script": "请停在这儿,谢谢!",
                "romanization": "Qǐng tíng zài zhèr, xièxie!",
                "english": "Please stop here, thanks!"
              },
              {
                "speaker": "Driver",
                "script": "好的。",
                "romanization": "Hǎo de.",
                "english": "Okay."
              }
            ]
          },
