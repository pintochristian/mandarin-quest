          "grammar": {
            "code": "dao-destination",
            "title": "Going To (到 = to / until)",
            "simpleExplanation": "到 (dào) marks a destination. Put it after a verb like 要 and before the place you're heading to: 我要到火车站 = \"I want to go to the train station.\" Think of 到 as pointing your sentence at an endpoint — it also works in questions: 你要到哪儿? = \"Where do you want to go (to)?\"",
            "visualExamples": [
              {
                "script": "我要到火车站。",
                "romanization": "Wǒ yào dào huǒchēzhàn.",
                "english": "I want to go to the train station."
              },
              {
                "script": "我要到机场。",
                "romanization": "Wǒ yào dào jīchǎng.",
                "english": "I want to go to the airport.",
                "note": "到 + place = your destination"
              },
              {
                "script": "你要到哪儿?",
                "romanization": "Nǐ yào dào nǎr?",
                "english": "Where do you want to go?",
                "note": "到哪儿 = 'to where' — asking for a destination"
              }
            ],
            "difficulty": 2,
            "quiz": [
              {
                "prompt": "In 我要到火车站, what does 到 mark?",
