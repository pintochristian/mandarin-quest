              {
                "script": "你家有几口人?",
                "romanization": "Nǐ jiā yǒu jǐ kǒu rén?",
                "english": "How many people are in your family?"
              },
              {
                "script": "我家有四个人。",
                "romanization": "Wǒ jiā yǒu sì gè rén.",
                "english": "There are four people in my family.",
                "note": "个 works for people in general — 口 is used specifically for counting family members"
              },
              {
                "script": "我有两个姐姐。",
                "romanization": "Wǒ yǒu liǎng gè jiějie.",
                "english": "I have two older sisters.",
                "note": "两 (not 二) is used right before a measure word"
              }
            ],
            "difficulty": 2,
