            "title": "Asking the Time",
            "situationTag": "daily-life",
            "lines": [
              {
                "speaker": "A",
                "script": "请问,现在几点?",
                "romanization": "Qǐngwèn, xiànzài jǐ diǎn?",
                "english": "Excuse me, what time is it now?"
              },
              {
                "speaker": "B",
                "script": "现在早上八点半。",
                "romanization": "Xiànzài zǎoshang bā diǎn bàn.",
                "english": "It's 8:30 in the morning now."
              },
              {
                "speaker": "A",
                "script": "谢谢!你忙吗?",
                "romanization": "Xièxie! Nǐ máng ma?",
                "english": "Thanks! Are you busy?"
              },
              {
                "speaker": "B",
                "script": "现在不忙。晚上我很忙。",
                "romanization": "Xiànzài bù máng. Wǎnshang wǒ hěn máng.",
                "english": "Not busy now. In the evening I'm very busy."
              },
              {
                "speaker": "A",
                "script": "好的,谢谢你!",
                "romanization": "Hǎo de, xièxie nǐ!",
                "english": "Okay, thank you!"
              }
            ]
