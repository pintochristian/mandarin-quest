        {
          "index": 3,
          "title": "Me Too",
          "situationTag": "daily-life",
          "estimatedMinutes": 18,
          "isPublished": true,
          "grammar": {
            "code": "dou-all",
            "title": "All of Us (都)",
            "simpleExplanation": "都 (dōu) means 'all' or 'both,' and it always goes AFTER the subject and BEFORE the verb: 我们都很忙 = We're all busy. You already know 也 (yě, 'also'), which adds one more item to a statement — 我也很忙 (I'm also busy). 都 sums up a whole group at once instead of adding just one person. You can even stack them: 我们也都很忙 = We're all also busy — 也 comes right before 都.",
            "visualExamples": [
              {
                "script": "我们都很忙。",
                "romanization": "Wǒmen dōu hěn máng.",
                "english": "We're all busy."
              },
              {
                "script": "你们都是学生吗?",
                "romanization": "Nǐmen dōu shì xuéshēng ma?",
                "english": "Are you all students?"
              },
              {
                "script": "我们也都很忙。",
                "romanization": "Wǒmen yě dōu hěn máng.",
                "english": "We're all also busy.",
                "note": "也都 = 'also all' — 也 then 都, both sit before the verb"
              }
            ],
            "difficulty": 2,
            "quiz": [
              {
                "prompt": "Where does 都 go in a sentence?",
                "options": [
                  "After the verb",
                  "After the subject, before the verb",
                  "At the very end",
                  "Before the subject"
                ],
                "correctIndex": 1
              },
              {
                "prompt": "我们都很忙 means:",
                "options": ["I'm busy.", "We're all busy.", "Are we busy?", "We're also busy."],
                "correctIndex": 1
              }
            ]
          },
