        {
          "index": 2,
          "title": "What Are You Doing?",
          "situationTag": "daily-life",
          "estimatedMinutes": 18,
          "isPublished": true,
          "grammar": {
            "code": "zai-progressive",
            "title": "Right Now (在 + Verb)",
            "simpleExplanation": "You already know 在 (zài) as 'is located at' — 洗手间在哪儿? (Where's the bathroom?). 在 has a second common job: put it right before a verb to say an action is happening right now, like English '-ing'. 我在吃饭 = I'm eating (right now). Same word, different spot: before a place = location, before a verb = an action in progress.",
            "visualExamples": [
              {
                "script": "我在吃饭。",
                "romanization": "Wǒ zài chī fàn.",
                "english": "I'm eating."
              },
              {
                "script": "你在做什么?",
                "romanization": "Nǐ zài zuò shénme?",
                "english": "What are you doing?",
                "note": "在 + verb = an action happening right now"
              },
              {
                "script": "他在看书。",
                "romanization": "Tā zài kàn shū.",
                "english": "He's reading."
              }
            ],
            "difficulty": 3,
            "quiz": [
              {
                "prompt": "In 我在吃饭, what job is 在 doing?",
                "options": [
                  "Showing location",
                  "Showing an action is happening right now",
                  "Asking a question",
                  "Meaning 'also'"
                ],
                "correctIndex": 1
              },
              {
                "prompt": "How do you ask 'What are you doing?'",
                "options": ["你在做什么?", "你做在什么?", "你什么在做?", "在你做什么?"],
